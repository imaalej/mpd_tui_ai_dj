# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Ignore the *contents* of the data directories, not the directories (audit L9).
#
# This used to read `data/state/` and `data/embeddings/`, then try to re-include
# `!data/state/.gitkeep` underneath them.  git cannot do that: once a directory
# is excluded it is never descended into, so a negation for something inside it
# can never match.  `git ls-files data` returned only `data/.gitkeep`, and the
# scaffolding a fresh clone was supposed to get did not ship.  Trailing `/*`
# keeps the directory itself visible, so the negations below work.

# User-specific learned data (personalized to each user's taste)
data/state/*
!data/state/.gitkeep

# Embeddings (large files generated from the user's own music library)
data/embeddings/*
!data/embeddings/.gitkeep

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# NOTE: tests/ is deliberately NOT ignored.  This file used to carry
# `test_*.py`, which meant a fresh clone had zero tests while the three
# untracked phase-test files reported "66 passing" locally (audit M1).

# Throwaway output from the offline explorers (`scratch_vibe_terminal.html`,
# `scratch_scaffold/`).  The scripts are tracked; what they render is not.
scratch_*

# Logs
*.log

# Environment variables
.env
.env.local
